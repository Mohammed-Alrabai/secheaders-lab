exports[`remediation snippets (FR-05, 07 task 2.6) > apache snapshot 1`] = `
{
  "CK-HTTPONLY": {
    "code": "# Prefer setting these flags in the application; this rewrites every cookie.
Header always edit Set-Cookie ^(.*)$ "$1; Secure; HttpOnly; SameSite=Lax"
",
    "filename": "VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "CK-PREFIX": {
    "kind": "instructions",
    "messageKey": "remediation.apache.CK-PREFIX",
  },
  "CK-SAMESITE": {
    "code": "# Prefer setting these flags in the application; this rewrites every cookie.
Header always edit Set-Cookie ^(.*)$ "$1; Secure; HttpOnly; SameSite=Lax"
",
    "filename": "VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "CK-SECURE": {
    "code": "# Prefer setting these flags in the application; this rewrites every cookie.
Header always edit Set-Cookie ^(.*)$ "$1; Secure; HttpOnly; SameSite=Lax"
",
    "filename": "VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-COOP": {
    "code": "Header always set Cross-Origin-Opener-Policy "same-origin"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-CSP": {
    "code": "# Tailor the sources to your site; deploy as Content-Security-Policy-Report-Only first.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-DUPLICATE": {
    "kind": "instructions",
    "messageKey": "remediation.apache.HDR-DUPLICATE",
  },
  "HDR-FRAME": {
    "code": "# CSP frame-ancestors 'none' is the modern equivalent; sending both is fine.
Header always set X-Frame-Options "DENY"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-HSTS": {
    "code": "# Keep "preload" only if you will submit the domain to the HSTS preload list.
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-PERMISSIONS": {
    "code": "Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-REFERRER": {
    "code": "Header always set Referrer-Policy "strict-origin-when-cross-origin"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-XCTO": {
    "code": "Header always set X-Content-Type-Options "nosniff"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "HDR-XXSS": {
    "code": "# The XSS auditor is obsolete; "0" disables it in legacy browsers. Rely on CSP.
Header always set X-XSS-Protection "0"
",
    "filename": ".htaccess or VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "INF-ASPNET": {
    "kind": "instructions",
    "messageKey": "remediation.apache.INF-ASPNET",
  },
  "INF-POWERED-BY": {
    "code": "Header always unset X-Powered-By
Header unset X-Powered-By
",
    "filename": "VirtualHost (mod_headers)",
    "kind": "code",
    "language": "apache",
  },
  "INF-SERVER": {
    "code": "ServerTokens Prod
ServerSignature Off
",
    "filename": "apache2.conf / httpd.conf",
    "kind": "code",
    "language": "apache",
  },
  "TLS-AVAILABLE": {
    "kind": "instructions",
    "messageKey": "remediation.apache.TLS-AVAILABLE",
  },
  "TLS-CERT-EXPIRY": {
    "kind": "instructions",
    "messageKey": "remediation.apache.TLS-CERT-EXPIRY",
  },
  "TLS-CERT-VALID": {
    "kind": "instructions",
    "messageKey": "remediation.apache.TLS-CERT-VALID",
  },
  "TLS-HTTP-REDIRECT": {
    "code": "RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
",
    "filename": ".htaccess or VirtualHost *:80 (mod_rewrite)",
    "kind": "code",
    "language": "apache",
  },
  "TLS-PROTOCOL": {
    "code": "SSLProtocol -all +TLSv1.2 +TLSv1.3
",
    "filename": "ssl.conf or VirtualHost",
    "kind": "code",
    "language": "apache",
  },
}
`;

