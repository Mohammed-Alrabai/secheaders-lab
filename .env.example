# Copy to .env.local for local overrides. No secrets are needed for the MVP.
# Public origin of the site (required in production; used for the same-origin check, SC-25).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Total time budget for one scan in milliseconds (1000-20000).
SCAN_TOTAL_BUDGET_MS=8000
# Scans per minute per client IP (defense-in-depth limiter, SC-24).
SCAN_RATE_LIMIT_PER_MIN=10
